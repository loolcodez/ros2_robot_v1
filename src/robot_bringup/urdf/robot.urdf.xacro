<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org" name="oma_robotti">

  <!-- Ground point below robot between axis -->
  <link name="base_footprint"/>

  <!-- Robot base-->
  <link name="base_link">
    <visual>
      <geometry>
        <!-- X (depth), Y (width), and Z (height)  -->
        <!-- Robot total size measured form wheels depth=0.22m, width=0.23m, high=0.07m -->
        <!-- Robot base plate depth=0.20m, width=0.15m, hight=0.07m -->
        <box size="0.20 0.15 0.07"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Lift up body 7cm from earth -->
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- ================= SENSOR LINKS ================= -->

  <!-- Front left TOF-SENSOR -->
  <link name="tof_front_left_link">
    <visual>
      <geometry>
        <!-- Small box sensor -->
        <box size="0.02 0.04 0.02"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Front right TOF-SENSOR -->
  <link name="tof_front_right_link">
    <visual>
      <geometry>
        <!-- Small box sensor -->
        <box size="0.02 0.04 0.02"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Back left TOF-SENSOR -->
  <link name="tof_back_left_link">
    <visual>
      <geometry>
        <!-- Small box sensor -->
        <box size="0.02 0.04 0.02"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <!-- back right TOF-SENSOR -->
  <link name="tof_back_right_link">
    <visual>
      <geometry>
        <!-- Small box sensor -->
        <box size="0.02 0.04 0.02"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>
  
  <!-- ================= JOINTS ================= -->
  
  <!-- Front Left -->
  <joint name="tof_front_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tof_front_left_link"/>
    <origin xyz="0.09 0.08 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Front Right -->
  <joint name="tof_front_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tof_front_right_link"/>
    <origin xyz="0.09 -0.08 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Back Left (turned 180 degrees) -->
  <joint name="tof_back_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tof_back_left_link"/>
    <origin xyz="-0.09 0.08 0.08" rpy="0 0 3.14159"/>
  </joint>

  <!-- Back Right (turned 180 degrees) -->
  <joint name="tof_back_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tof_back_right_link"/>
    <origin xyz="-0.09 -0.08 0.08" rpy="0 0 3.14159"/>
  </joint>

</robot>
